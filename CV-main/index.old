<!DOCTYPE html>
<html lang="fr" style="--photo-radius: 14px; --photo-size: 149px;"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CV — BEYER Sébastien — MERM</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --navy:   #1e3f5c;
  --blue:   #1e4670;
  --mid:    #2e6ea6;
  --soft:   #6899bf;
  --pale:   #d6e8f5;
  --xpale:  #eef5fb;
  --slate:  #46607a;
  --muted:  #7a93a8;
  --silver: #dde6ee;
  --white:  #ffffff;
}

body {
  font-family: 'Inter', sans-serif;
  background: #c8d8e4;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2rem 1rem 4rem;
  gap: 16px;
}

/* ─── BARRE D'ÉDITION ─────────────────────────────── */
#edit-bar {
  width: 210mm;
  background: var(--navy);
  border-radius: 8px;
  padding: 10px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  box-shadow: 0 4px 20px rgba(15,35,55,0.25);
}
#edit-bar .eb-label {
  font-size: 9px; font-weight: 600;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--soft);
  flex-shrink: 0;
}
#edit-bar .eb-hint {
  font-size: 9px; color: rgba(255,255,255,0.35);
  flex: 1; min-width: 120px;
}
.eb-btn {
  font-size: 9px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 5px 12px; border-radius: 4px; border: none; cursor: pointer;
  transition: opacity 0.15s;
}
.eb-btn:hover { opacity: 0.8; }
.eb-btn.primary { background: var(--mid); color: #fff; }
.eb-btn.secondary { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); }
.eb-btn.danger { background: rgba(220,60,60,0.7); color: #fff; }

#edit-toggle-label {
  display: flex; align-items: center; gap: 7px;
  cursor: pointer; user-select: none;
}
#edit-toggle { display: none; }
.toggle-track {
  width: 32px; height: 16px; border-radius: 8px;
  background: rgba(255,255,255,0.15);
  position: relative; transition: background 0.2s;
}
.toggle-thumb {
  position: absolute; top: 2px; left: 2px;
  width: 12px; height: 12px; border-radius: 50%;
  background: rgba(255,255,255,0.4);
  transition: left 0.2s, background 0.2s;
}
#edit-toggle:checked ~ .toggle-track { background: var(--mid); }
#edit-toggle:checked ~ .toggle-track .toggle-thumb {
  left: 18px; background: #fff;
}

/* ─── PAGE A4 ────────────────────────────────────── */
@page { size: A4 portrait; margin: 0; }

@media print {
  body { background: none; padding: 0; margin: 0; gap: 0; }
  #edit-bar,
  #edit-actions,
  #edit-side-panel,
  #stage-modal-overlay,
  #xp-modal-overlay,
  #info-modal-overlay,
  .stage-form,
  .add-stage-btn,
  .stage-edit-btn,
  .stage-detail-hover,
  .stage-click-hint,
  .tl-click-hint,
  .stage-gap-dots .stage-card::before,
  .stage-gap-dots .stage-card::after,
  .drag-handle,
  .section-controls,
  .photo-debug,
  #photo-panel { display: none !important; }
  .page { box-shadow: none; }
  [data-hidden="true"] { display: none !important; }
  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}

.page {
  width: 210mm;
  min-height: 297mm;
  max-height: 297mm;
  background: var(--white);
  box-shadow: 0 12px 60px rgba(15,35,55,0.22);
  position: relative;
  overflow: visible;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

/* ─── DRAG HANDLES (mode édition) ──────────────────── */
.drag-handle {
  display: none;
  position: absolute;
  left: -28px; top: 50%;
  transform: translateY(-50%);
  width: 22px; height: 22px;
  background: var(--mid);
  border-radius: 4px;
  cursor: grab;
  align-items: center; justify-content: center;
  font-size: 11px; color: #fff;
  opacity: 0;
  transition: opacity 0.15s;
  z-index: 100;
}
.edit-mode .drag-handle { display: flex; }
.edit-mode [data-block]:hover .drag-handle { opacity: 1; }
.edit-mode [data-block]:active .drag-handle { cursor: grabbing; }

.section-controls {
  display: none;
  position: absolute;
  right: 4px; top: 4px;
  gap: 4px; z-index: 100;
}
.edit-mode .section-controls { display: flex; }

.sc-btn {
  width: 18px; height: 18px;
  border-radius: 3px; border: none;
  font-size: 9px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.15s;
}
.sc-btn:hover { opacity: 0.7; }
.sc-btn.hide { background: rgba(255,150,0,0.75); color: #fff; }
.sc-btn.show { background: rgba(60,180,60,0.75); color: #fff; }

/* Bloc caché en mode édition = semi-transparent */
.edit-mode [data-hidden="true"] {
  opacity: 0.3;
  outline: 1px dashed rgba(255,150,0,0.5);
}

/* Highlight drag-over */
.edit-mode [data-block].drag-over {
  outline: 2px dashed var(--mid);
  background: rgba(46,110,166,0.04);
}
.edit-mode [data-block].dragging { opacity: 0.4; }
.edit-mode [data-block] { position: relative; cursor: default; }
/* no layout shift in edit mode */

/* ─── HEADER ────────────────────────────────────────── */
.header {
  position: relative;
  height: 196px;
  flex-shrink: 0;
  background: transparent;
  overflow: visible;
  z-index: 2;
}
.header-bg {
  position: absolute; inset: 0;
  background: var(--navy);
  clip-path: polygon(0 0,100% 0,100% 72%,92% 88%,80% 100%,60% 90%,40% 105%,22% 92%,8% 100%,0 84%);
}
.scanner-placeholder {
  position: absolute; inset: 0;
  background: linear-gradient(120deg,#1a3a58 0%,#2a5a8a 45%,#3a7ab8 100%);
  clip-path: inherit;
}
.header-waves {
  position: absolute;
  bottom: -2px; left: 0; right: 0;
  height: 40px; overflow: visible; z-index: 3;
}
.scanner-deco {
  opacity: 0.10;
  position: absolute; right: 55px; top: 50%; transform: translateY(-52%);
}
.header-fade {
  position: absolute; inset: 0;
  background: linear-gradient(100deg,rgba(15,35,60,.75) 0%,rgba(30,65,100,.50) 50%,rgba(40,90,140,.10) 100%);
  clip-path: polygon(0 0,100% 0,100% 72%,92% 88%,80% 100%,60% 90%,40% 105%,22% 92%,8% 100%,0 84%);
}
.header-inner {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 18px;
  display: flex; align-items: flex-end;
  padding: 0 28px 14px; gap: 16px; z-index: 4;
}
.photo-wrap {
  width: var(--photo-size, 130px);
  height: var(--photo-size, 130px);
  flex-shrink: 0;
  border-radius: var(--photo-radius, 50%);
  border: 2.5px solid rgba(255,255,255,0.45);
  overflow: hidden;
  background: rgba(30,63,92,0.5);
  position: relative;
  cursor: grab;
  transition: border-radius 0.2s;
}
/* mask removed */
.photo-wrap .photo-img-wrap {
  position: absolute; inset: 0;
  z-index: 1;
}
.photo-wrap img {
  display: none;
  position: absolute;
  user-select: none;
  pointer-events: none;
}
.photo-wrap .photo-hint {
  position: absolute; inset: 0; border-radius: 50%; z-index: 3;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; color: rgba(255,255,255,0.9);
  background: rgba(0,0,0,0.3);
  opacity: 0; transition: opacity 0.15s;
  pointer-events: none;
}
.photo-wrap .photo-img-wrap:hover + .photo-hint,
.photo-wrap .photo-img-wrap:hover ~ .photo-hint { opacity: 1; }
.header-text { flex: 1; }
.header-eyebrow {
  font-size: 9px; font-weight: 400;
  letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--soft); margin-bottom: 3px;
}
.header-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 29px; font-weight: 600; color: #fff;
  line-height: 1; letter-spacing: 0.01em;
  position: relative;
  left: var(--name-x, 0px);
  top: var(--name-y, 0px);
  cursor: default;
}
.header-tagline {
  font-size: 10.5px; font-weight: 300;
  color: rgba(255,255,255,0.72);
  letter-spacing: 0.05em; margin-top: 5px; line-height: 1.5;
}
.header-age {
  font-size: 9.5px; color: rgba(255,255,255,0.35);
  margin-top: 3px; letter-spacing: 0.04em;
}
.header-meta {
  position: absolute; top: 38px; right: 36px;
  display: flex; flex-direction: column; gap: 6px; align-items: flex-end;
  z-index: 4;
}
.meta-sep {
  font-size: 7.5px; font-weight: 500;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--soft); opacity: 0.8; text-align: right; margin-top: 1px;
}
.meta-item {
  display: flex; align-items: center; gap: 7px;
  font-size: 10px; color: rgba(255,255,255,0.82);
}
.meta-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--soft); flex-shrink: 0;
}

/* ─── TITRE MÉTIER ─────────────────────────────────── */
.titre-metier {
  flex-shrink: 0;
  background: var(--navy);
  padding: 5px 36px;
  font-family: 'Inter', sans-serif;
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--soft);
  border-top: 1px solid rgba(255,255,255,0.06);
}

/* ─── ACCROCHE ──────────────────────────────────────── */
.accroche {
  flex-shrink: 0;
  background: linear-gradient(90deg, var(--pale) 0%, var(--xpale) 100%);
  border-left: 3.5px solid var(--mid);
  padding: 7px 36px 7px 33px;
  font-size: 10px; line-height: 1.6;
  color: var(--navy); font-weight: 400;
  margin-top: 8px; letter-spacing: 0.01em;
}

/* ─── BODY 2 COL ────────────────────────────────────── */
.body {
  flex: 1;
  min-height: 0;
  padding: 8px 36px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 28px;
  align-items: stretch;
  overflow: visible;
}

/* ─── COLUMNS ──────────────────────────────────────── */
#col-left {
  display: flex;
  flex-direction: column;
  overflow: visible;
  position: relative;
  z-index: 2;
}
#col-right {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 10;
}
/* The stages block inside col-left grows to fill height */
#col-left > [data-block="stages"] {
  flex: 1;
  display: flex;
  flex-direction: column;
}
/* stage-cards container inside stages block */
#col-left [data-block="stages"] > .sh {
  flex-shrink: 0;
}

/* ─── SECTION HEADING ───────────────────────────────── */
.sh {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 5px; margin-top: 9px;
}
.sh-bar {
  width: 22px; height: 2.5px;
  background: linear-gradient(90deg, var(--mid), var(--soft));
  border-radius: 2px; flex-shrink: 0;
}
.sh-text {
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--blue); white-space: nowrap;
}
.sh-line {
  flex: 1; height: 14px; position: relative; overflow: visible; min-width: 0;
}
.sh-line svg {
  position: absolute; top: 50%; left: 0;
  transform: translateY(-50%);
  width: 100%; height: 14px; overflow: visible;
}

/* ─── TIMELINE ──────────────────────────────────────── */
.tl { position: relative; }
.tl-item {
  position: relative;
  padding-left: 16px;
  margin-bottom: 6px;
}
.tl-item::before {
  content: '';
  position: absolute; left: 0; top: 5px;
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--pale); border: 2px solid var(--soft);
}
.tl-item::after {
  content: '';
  position: absolute; left: 2.5px; top: 13px;
  width: 1px; bottom: -6px;
  background: var(--silver);
}
.tl-item:last-child::after { display: none; }
.tl-date {
  font-size: 9px; font-weight: 500;
  color: var(--mid); letter-spacing: 0.06em; margin-bottom: 1px;
}
.tl-title {
  font-size: 11.5px; font-weight: 600;
  color: var(--navy); margin-bottom: 1px;
}
.tl-place {
  font-size: 10px; color: var(--muted);
  font-style: italic; margin-bottom: 2px;
}
.tl-desc {
  font-size: 10px; color: var(--slate);
  line-height: 1.55; font-weight: 300;
}
.tl-desc li {
  margin-left: 11px; margin-bottom: 2px; list-style: disc;
}

/* ─── STAGE CARDS ───────────────────────────────────── */
.stage-card {
  border-left: 2px solid var(--pale);
  padding: 5px 7px 5px 9px;
  margin-bottom: 5px;
  background: var(--xpale);
  border-radius: 0 5px 5px 0;
  position: relative;
}
/* Gap stripes — same color as card background, invisible until gap added */
.stage-card {
  border-top: 0px solid #eef5fb;
  border-bottom: 0px solid #eef5fb;
}
.stage-card.current {
  border-left: 3px solid var(--mid);
  background: linear-gradient(90deg, rgba(46,110,166,0.08) 0%, var(--xpale) 100%);
  position: relative;
}
.stage-card.current::after {
  content: '▶ EN COURS';
  position: absolute; right: 8px; top: 6px;
  font-size: 6.5px; font-weight: 700; letter-spacing: 0.12em;
  color: var(--mid); opacity: 0.7;
}
.stage-date {
  font-size: 9px; font-weight: 600;
  color: var(--mid); margin-bottom: 1px; letter-spacing: 0.04em;
}
.stage-title {
  font-size: 10.5px; font-weight: 600;
  color: var(--navy); margin-bottom: 1px;
}
.stage-lieu {
  font-size: 9.5px; color: var(--muted);
  font-style: italic; margin-bottom: 4px;
}
.stage-tags {
  display: flex; flex-wrap: wrap; gap: 2px;
}
.stag {
  font-size: 8.5px; padding: 1.5px 6px;
  background: var(--pale); color: var(--blue);
  border-radius: 20px; font-weight: 500;
  border: 0.5px solid rgba(46,110,166,0.18);
}

/* ─── STAGE AP NOTE ─── */
.stage-ap {
  margin-top: 3px;
  font-size: 8.5px; font-style: italic;
  color: var(--slate); font-weight: 400;
  border-top: 1px dashed var(--pale);
  padding-top: 4px;
  letter-spacing: 0.01em;
}

/* ─── TAGS ──────────────────────────────────────────── */
.tag-cloud { display: flex; flex-wrap: wrap; gap: 4px; }
.tag {
  font-size: 10px; padding: 3px 9px;
  background: var(--xpale);
  border: 0.5px solid var(--silver);
  color: var(--slate);
  border-radius: 20px; font-weight: 400;
}
.tag.accent {
  background: var(--pale); color: var(--blue);
  border-color: rgba(46,110,166,0.3); font-weight: 500;
}

/* ─── CERTIF ────────────────────────────────────────── */
.certif-row {
  display: flex; align-items: flex-start;
  gap: 7px; margin-bottom: 3px;
}
.certif-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--soft); flex-shrink: 0; margin-top: 4px;
}
.certif-text { font-size: 10.5px; color: var(--slate); line-height: 1.4; }
.certif-text strong { font-weight: 500; color: var(--navy); }

/* ─── VAGUE + BANDE BAS ─────────────────────────────── */
.wave-separator {
  flex-shrink: 0; height: 20px;
  position: relative; overflow: hidden;
  z-index: 1;
}
.wave-separator svg {
  position: absolute; inset: 0; width: 100%; height: 100%;
}
.bottom-band {
  flex-shrink: 0;
  background: var(--xpale);
  padding: 6px 36px 7px;
  display: flex; gap: 0; align-items: flex-start;
  position: relative;
  z-index: 1;
}
.bottom-col { flex: 1; }
.bottom-divider {
  width: 1px; background: var(--silver);
  align-self: stretch; margin: 0 16px; flex-shrink: 0;
}

/* ─── BLOCK TOOLBAR (mode édition) ─────────────────── */
/* ─── PHOTO CONTROLS IN SIDE PANEL ──────────────────── */
.sp-photo-ctrl { padding: 4px 0; }
.sp-photo-row {
  display: flex; align-items: center; gap: 6px;
  padding: 3px 0;
  font-size: 8px; color: var(--muted);
}
.sp-photo-row label { min-width: 44px; }
.sp-photo-row input[type=range] { flex:1; accent-color: var(--mid); }
.sp-photo-row span { min-width: 30px; color: #fff; text-align: right; font-size: 8px; }
.sp-shape-btns { display: flex; gap: 4px; margin-top: 4px; }
.sp-shape-btn {
  font-size: 8px; padding: 3px 8px;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
  border-radius: 3px; color: rgba(255,255,255,0.7); cursor: pointer;
}
.sp-shape-btn.active { background: var(--mid); border-color: var(--mid); color: #fff; }

/* ─── SIDE PANEL (mode édition) ─────────────────────── */
#edit-side-panel {
  display: none;
  position: fixed;
  right: 0; top: 50%;
  transform: translateY(-50%);
  width: 200px;
  background: var(--navy);
  border-radius: 8px 0 0 8px;
  padding: 10px 0;
  z-index: 1000;
  box-shadow: -4px 0 20px rgba(0,0,0,0.3);
  max-height: 90vh;
  overflow-y: auto;
}
#edit-side-panel.visible { display: block; }
.sp-section {
  padding: 6px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.sp-section:last-child { border-bottom: none; }
.sp-block-row {
  display: flex; align-items: center;
  gap: 6px; padding: 4px 0;
  cursor: pointer;
  border-radius: 4px;
  transition: background 0.1s;
}
.sp-block-row:hover { background: rgba(255,255,255,0.06); }
.sp-block-row.active { background: rgba(46,110,166,0.3); }
.sp-block-name {
  flex: 1; font-size: 9px; color: rgba(255,255,255,0.8);
  font-weight: 500; letter-spacing: 0.08em;
}
.sp-vis-btn {
  font-size: 10px; width: 18px; height: 18px;
  background: none; border: none; cursor: pointer;
  color: rgba(255,255,255,0.5); border-radius: 3px;
  display: flex; align-items: center; justify-content: center;
}
.sp-vis-btn:hover { background: rgba(255,255,255,0.15); color: #fff; }
.sp-drag-btn {
  font-size: 10px; cursor: grab; color: var(--soft);
  padding: 0 2px;
}
.sp-title-row {
  font-size: 8px; font-weight: 700; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--soft);
  padding: 4px 0 2px;
}
.sp-spacer-row {
  display: flex; align-items: center; gap: 6px; padding: 3px 0;
}
.sp-spacer-range { flex:1; accent-color: var(--mid); }
.sp-spacer-val { font-size: 9px; color: #fff; min-width: 28px; text-align: right; }

/* Highlight hovered block on page */
.edit-mode [data-block].sp-hover {
  outline: 2px solid var(--mid);
  outline-offset: 1px;
}

/* block-toolbar kept for drag handle only, no layout impact */
.block-toolbar { display: none; }
.bt-label, .bt-btn, .bt-drag { display: none; }

/* ─── SPACER PANEL ───────────────────────────────────── */
.spacer-panel {
  position: absolute; bottom: calc(100% + 4px); left: 0;
  background: var(--navy); border-radius: 6px;
  padding: 10px 12px; z-index: 300;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  min-width: 200px;
}
.sp-title {
  font-size: 9px; font-weight: 600; letter-spacing: 0.16em;
  text-transform: uppercase; color: var(--soft); margin-bottom: 8px;
}
.sp-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.sp-range { flex: 1; accent-color: var(--mid); }
.sp-val { font-size: 9px; color: #fff; min-width: 28px; }
.sp-presets { display: flex; gap: 4px; margin-bottom: 8px; }
.sp-preset {
  font-size: 8px; padding: 2px 6px;
  background: rgba(255,255,255,0.1); border: none;
  border-radius: 3px; color: rgba(255,255,255,0.7); cursor: pointer;
}
.sp-preset:hover { background: var(--mid); color: #fff; }
.sp-close {
  width: 100%; font-size: 9px; padding: 4px;
  background: var(--mid); border: none; border-radius: 3px;
  color: #fff; cursor: pointer; font-weight: 600;
}

/* ─── BLANK BLOCK ────────────────────────────────────── */
.blank-content:empty::before {
  content: attr(placeholder);
  color: var(--muted); font-style: italic;
}

/* Marge top visible en mode édition */
.edit-mode [data-block] { margin-top: var(--mt, 0px); }

/* ─── PHOTO PANEL ──────────────────────────────────────── */
#photo-panel {
  display: none;
  position: absolute;
  left: 105px; top: 80px;
  background: var(--navy);
  border-radius: 8px;
  padding: 12px 14px;
  z-index: 500;
  min-width: 220px;
  box-shadow: 0 6px 24px rgba(0,0,0,0.4);
}
#photo-panel.visible { display: block; }
.pp-title {
  font-size: 9px; font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--soft); margin-bottom: 10px;
}
.pp-row {
  display: flex; align-items: center; gap: 8px; margin-bottom: 7px;
}
.pp-row label {
  font-size: 9px; color: rgba(255,255,255,0.6);
  min-width: 50px;
}
.pp-row input[type=range] {
  flex: 1; accent-color: var(--mid);
}
.pp-val {
  font-size: 9px; color: #fff; min-width: 32px; text-align: right;
}
.pp-close {
  width: 100%; margin-top: 8px;
  font-size: 9px; padding: 5px;
  background: var(--mid); border: none; border-radius: 4px;
  color: #fff; cursor: pointer; font-weight: 600;
}



/* ─── FOOTER ────────────────────────────────────────── */
.footer {
  flex-shrink: 0; height: 24px;
  background: var(--navy);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 36px;
}
.footer-t {
  font-size: 8.5px; color: rgba(255,255,255,0.28);
  letter-spacing: 0.12em; text-transform: uppercase;
}

/* ─── SHARED SH HELPER ──────────────────────────────── */
.sh-wave { display: contents; }

/* ─── STAGE EXPAND ON HOVER ─────────────────────────────────────── */
.stage-card {
  transition: none; /* no transition by default - instant in print */
  cursor: default;
}
/* Only expand in browser, not print */
@media screen {
  .stage-card {
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    cursor: pointer;
    position: relative;
  }
  .stage-card:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(30,63,92,0.18);
    z-index: 100;
    background: var(--white);
  }
  /* On hover: show 1-2 extra lines of info */
  .stage-detail-hover {
    display: none;
    margin-top: 5px;
    padding-top: 5px;
    border-top: 1px dashed var(--pale);
    font-size: 8.5px;
    color: var(--muted);
    line-height: 1.55;
    font-style: italic;
  }
  .stage-card:hover .stage-detail-hover { display: block; }
  /* "..." click hint centered at bottom of card */
  .stage-click-hint {
    display: none;
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--soft);
    margin-top: 4px;
    opacity: 0.7;
  }
  .stage-card:hover .stage-click-hint { display: block; }
  /* Extra tags shown only on hover */
  .stag.hover-only { display: none; }
  .stage-card:hover .stag.hover-only { display: inline-block; }
  /* Add stage button in edit mode */
  .add-stage-btn {
    display: none;
    width: 100%;
    margin-top: 6px;
    padding: 5px;
    background: rgba(46,110,166,0.08);
    border: 1px dashed var(--soft);
    border-radius: 4px;
    color: var(--mid);
    font-size: 9px;
    cursor: pointer;
    text-align: center;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .edit-mode .add-stage-btn { display: block; }
  .add-stage-btn:hover { background: rgba(46,110,166,0.15); }
}

/* ─── STAGE MODAL ─────────────────────────────────────────────────── */
#stage-modal-overlay {
  display: none;
  position: fixed; inset: 0;
  background: rgba(15,30,50,0.55);
  backdrop-filter: blur(3px);
  z-index: 1000;
  align-items: center; justify-content: center;
}
#stage-modal-overlay.open { display: flex; }

#stage-modal {
  background: #fff;
  border-radius: 12px;
  padding: 0;
  width: 520px;
  max-width: 92vw;
  max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(15,30,50,0.35);
  animation: modalIn 0.22s ease;
  position: relative;
}
@keyframes modalIn {
  from { opacity: 0; transform: translateY(12px) scale(0.97); }
  to   { opacity: 1; transform: none; }
}

.sm-header {
  background: var(--navy);
  padding: 20px 24px 16px;
  border-radius: 12px 12px 0 0;
  position: relative;
}
.sm-date {
  font-size: 10px; font-weight: 600; color: var(--soft);
  letter-spacing: 0.1em; margin-bottom: 4px;
}
.sm-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 600; color: #fff;
  line-height: 1.1; margin-bottom: 3px;
}
.sm-lieu {
  font-size: 11px; color: rgba(255,255,255,0.55); font-style: italic;
}
.sm-close {
  position: absolute; top: 14px; right: 16px;
  background: rgba(255,255,255,0.15); border: none;
  color: #fff; border-radius: 50%;
  width: 28px; height: 28px; font-size: 16px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.15s;
}
.sm-close:hover { background: rgba(255,255,255,0.28); }

.sm-body { padding: 18px 24px 20px; }

.sm-tags {
  display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 14px;
}
.sm-tag {
  font-size: 10px; padding: 3px 10px;
  background: var(--pale); color: var(--blue);
  border-radius: 20px; font-weight: 500;
  border: 0.5px solid rgba(46,110,166,0.18);
}

.sm-section-title {
  font-size: 8.5px; font-weight: 700; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--mid);
  margin-bottom: 6px; margin-top: 14px;
}
.sm-section-title:first-child { margin-top: 0; }

.sm-detail {
  font-size: 12px; color: var(--slate); line-height: 1.7;
  white-space: pre-wrap;
}

.sm-ap-link {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 12px; padding: 8px 14px;
  background: var(--xpale); border: 1px solid var(--pale);
  border-radius: 8px; text-decoration: none;
  color: var(--blue); font-size: 11px; font-weight: 500;
  transition: background 0.15s;
}
.sm-ap-link:hover { background: var(--pale); }
.sm-ap-link svg { flex-shrink: 0; }

/* Tag manager in modal */
.sm-tag-manager { margin-top: 4px; }
.sm-tag-pill {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 10px; padding: 3px 10px;
  background: var(--pale); color: var(--blue);
  border-radius: 20px; font-weight: 500;
  border: 1.5px solid rgba(46,110,166,0.2);
  margin: 2px 2px; cursor: pointer;
  transition: opacity 0.15s, background 0.15s;
  user-select: none;
}
.sm-tag-pill.hidden-tag {
  opacity: 0.35;
  background: var(--silver);
  color: var(--muted);
  border-color: var(--silver);
  text-decoration: line-through;
}
.sm-tag-pill:hover { border-color: var(--mid); }

/* Info tag (savoir-être, intérêts) */
@media screen {
  .info-tag {
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .info-tag:hover {
    background: var(--pale) !important;
    border-color: var(--mid) !important;
    color: var(--blue) !important;
  }
}

/* Stage bilan icon in modal */
.sm-bilan-btn {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 10px; padding: 7px 14px;
  background: var(--xpale); border: 1px solid var(--pale);
  border-radius: 8px; text-decoration: none;
  color: var(--blue); font-size: 11px; font-weight: 500;
  cursor: pointer; transition: background 0.15s;
}
.sm-bilan-btn:hover { background: var(--pale); }

/* Info modal (savoir-être, intérêts) */
#info-modal-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(15,30,50,0.45);
  backdrop-filter: blur(3px);
  z-index: 1100;
  align-items: center; justify-content: center;
}
#info-modal-overlay.open { display: flex; }
#info-modal {
  background: #fff; border-radius: 12px;
  width: 420px; max-width: 90vw;
  box-shadow: 0 16px 48px rgba(15,30,50,0.3);
  animation: modalIn 0.18s ease; overflow: hidden;
}
.im-header {
  background: var(--navy); padding: 16px 20px;
  display: flex; align-items: center; justify-content: space-between;
}
.im-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px; font-weight: 600; color: #fff;
}
.im-close {
  background: rgba(255,255,255,0.15); border: none; color: #fff;
  border-radius: 50%; width: 26px; height: 26px;
  font-size: 14px; cursor: pointer; display: flex;
  align-items: center; justify-content: center;
}
.im-body {
  padding: 18px 20px 20px;
  font-size: 12px; color: var(--slate);
  line-height: 1.7;
}
.im-body p {
  margin-bottom: 8px;
}
.im-body p:last-child { margin-bottom: 0; }
.im-section {
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--mid); margin: 12px 0 5px;
}
.im-section:first-child { margin-top: 0; }
.im-list {
  list-style: none; margin: 0 0 8px 0; padding: 0;
}
.im-list li {
  padding: 3px 0 3px 16px;
  position: relative; font-size: 12px; color: var(--slate);
  line-height: 1.55;
}
.im-list li::before {
  content: "–";
  position: absolute; left: 0;
  color: var(--soft); font-weight: 600;
}
/* Same structure for sm-detail and xm-detail */
#sm-detail p, #xm-detail p { margin-bottom: 8px; }
#sm-detail .im-section, #xm-detail .im-section {
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--mid); margin: 12px 0 5px;
}
#sm-detail .im-list, #xm-detail .im-list {
  list-style: none; margin: 0 0 8px; padding: 0;
}
#sm-detail .im-list li, #xm-detail .im-list li {
  padding: 3px 0 3px 16px; position: relative;
  font-size: 12px; color: var(--slate); line-height: 1.55;
}
#sm-detail .im-list li::before, #xm-detail .im-list li::before {
  content: "–"; position: absolute; left: 0;
  color: var(--soft); font-weight: 600;
}

/* Experience tl-item hover */
@media screen {
  .tl-item[data-xp-detail] {
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.15s;
    padding-right: 4px;
  }
  .tl-item[data-xp-detail]:hover {
    background: rgba(46,110,166,0.05);
  }
  .tl-item[data-xp-detail]:hover .tl-title {
    color: var(--mid);
  }
  .tl-click-hint {
    display: none;
    font-size: 10px;
    color: var(--soft);
    letter-spacing: 0.15em;
    margin-top: 2px;
    opacity: 0.6;
  }
  .tl-item[data-xp-detail]:hover .tl-click-hint { display: block; }
}

/* Edit pencil on card (edit mode only) */
.stage-edit-btn {
  display: none;
  position: absolute; top: 5px; right: 5px;
  width: 18px; height: 18px;
  background: var(--mid); border: none; border-radius: 3px;
  color: #fff; font-size: 9px; cursor: pointer;
  align-items: center; justify-content: center; z-index: 10;
}
.edit-mode .stage-card .stage-edit-btn { display: flex; }

/* ─── STAGE FORM (edit mode) ─────────────────────────────────────── */
.stage-form {
  display: none;
  background: rgba(238,245,251,0.95);
  border: 1px solid var(--pale);
  border-radius: 6px;
  padding: 10px;
  margin-top: 8px;
  z-index: 200;
  position: relative;
}
.stage-form.visible { display: block; }
.sf-row {
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 5px;
}
.sf-row label {
  font-size: 8px; font-weight: 600;
  color: var(--blue); min-width: 48px;
  letter-spacing: 0.08em; text-transform: uppercase;
}
.sf-row input, .sf-row textarea {
  flex: 1; font-size: 9px; font-family: inherit;
  padding: 3px 6px; border: 1px solid var(--silver);
  border-radius: 3px; color: var(--slate); background: #fff;
}
.sf-row textarea { height: 44px; resize: vertical; }
.sf-btns { display: flex; gap: 6px; margin-top: 6px; }
.sf-btn {
  font-size: 8px; padding: 4px 10px;
  border: none; border-radius: 3px; cursor: pointer; font-weight: 600;
}
.sf-btn.ok  { background: var(--mid); color: #fff; }
.sf-btn.cancel { background: var(--silver); color: var(--slate); }
</style>
