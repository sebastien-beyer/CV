<body>

<!-- ══ BARRE D'ÉDITION ══════════════════════════════ -->
<div id="edit-bar">
  <label id="edit-toggle-label">
    <input type="checkbox" id="edit-toggle">
    <div class="toggle-track"><div class="toggle-thumb"></div></div>
    <span class="eb-label">Mode édition</span>
  </label>
  <div id="edit-actions" style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; flex: 1 1 0%;">
    <label style="font-size:9px;color:var(--soft);font-weight:600;letter-spacing:.1em;display:flex;align-items:center;gap:5px;">
      📷
      <label for="photo-file-input" style="background:var(--mid);color:#fff;font-size:9px;padding:4px 10px;border-radius:4px;cursor:pointer;font-weight:600;">Choisir photo</label>
      <input type="file" id="photo-file-input" accept="image/*" style="display:none;">
    </label>
    <div style="width:1px;height:20px;background:rgba(255,255,255,0.15);"></div>
    <label style="font-size:9px;color:var(--soft);font-weight:600;letter-spacing:.1em;display:flex;align-items:center;gap:5px;">
      Nom
      <input type="range" id="font-name" min="16" max="60" value="29" style="width:70px;accent-color:var(--mid);">
      <span id="font-name-val" style="color:#fff;font-size:9px;min-width:24px;">50</span>
    </label>
    <label style="font-size:9px;color:var(--soft);font-weight:600;letter-spacing:.1em;display:flex;align-items:center;gap:5px;">
      Titre
      <input type="range" id="font-titre" min="8" max="16" value="11" style="width:70px;accent-color:var(--mid);">
      <span id="font-titre-val" style="color:#fff;font-size:9px;min-width:24px;">16</span>
    </label>
    <div style="width:1px;height:20px;background:rgba(255,255,255,0.15);"></div>
    <label style="font-size:9px;color:var(--soft);font-weight:600;letter-spacing:.1em;display:flex;align-items:center;gap:5px;">
      Nom ←→
      <input type="range" id="name-x" min="-60" max="60" value="0" style="width:60px;accent-color:var(--mid);">
    </label>
    <label style="font-size:9px;color:var(--soft);font-weight:600;letter-spacing:.1em;display:flex;align-items:center;gap:5px;">
      Nom ↕
