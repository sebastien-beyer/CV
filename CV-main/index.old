  <div class="sp-section">
    <div class="sp-title-row">↕ Espacement</div>
    <div id="sp-spacer-ui"><div style="font-size: 8px; color: var(--soft); margin-bottom: 4px;">Accroche</div><div class="sp-spacer-row"><span style="font-size: 8px; color: var(--muted);">↑ avant</span><input type="range" class="sp-spacer-range" min="-20" max="40" id="sp-range-cur"><span class="sp-spacer-val" id="sp-val-cur">-2px</span></div><div style="display: flex; gap: 4px; margin-top: 4px;"><button style="font-size: 8px; padding: 2px 5px; background: rgba(255, 255, 255, 0.12); border: none; border-radius: 3px; color: rgba(255, 255, 255, 0.75); cursor: pointer;">-12</button><button style="font-size: 8px; padding: 2px 5px; background: rgba(255, 255, 255, 0.12); border: none; border-radius: 3px; color: rgba(255, 255, 255, 0.75); cursor: pointer;">-6</button><button style="font-size: 8px; padding: 2px 5px; background: rgba(255, 255, 255, 0.12); border: none; border-radius: 3px; color: rgba(255, 255, 255, 0.75); cursor: pointer;">0</button><button style="font-size: 8px; padding: 2px 5px; background: rgba(255, 255, 255, 0.12); border: none; border-radius: 3px; color: rgba(255, 255, 255, 0.75); cursor: pointer;">6</button><button style="font-size: 8px; padding: 2px 5px; background: rgba(255, 255, 255, 0.12); border: none; border-radius: 3px; color: rgba(255, 255, 255, 0.75); cursor: pointer;">12</button></div></div>
  </div>
  <div class="sp-section">
    <div class="sp-title-row">📷 Photo</div>
    <div class="sp-photo-ctrl">
      <div class="sp-photo-row">
        <label>Taille</label>
        <input type="range" id="sp-photo-size" min="80" max="180" value="130">
        <span id="sp-photo-size-val">149</span>
      </div>
      <div class="sp-shape-btns">
        <button class="sp-shape-btn" id="btn-shape-round">⬤ Rond</button>
        <button class="sp-shape-btn" id="btn-shape-square">■ Carré</button>
        <button class="sp-shape-btn active" id="btn-shape-rounded">▢ Arrondi</button>
      </div>
    </div>
  </div>
  <div class="sp-section">
    <div class="sp-title-row">↕ Espacement stages</div>
    <div style="padding:4px 0;">
      <div class="sp-photo-row" style="margin-bottom:6px;">
        <label>Entre stages</label>
        <input type="range" id="sp-stage-gap" min="0" max="30" value="5">
        <span id="sp-stage-gap-val">5px</span>
      </div>
    </div>
  </div>
  <div class="sp-section">
    <div class="sp-title-row">↕ Colonnes</div>
    <div style="padding:4px 0;display:flex;flex-direction:column;gap:6px;">
      <button class="eb-btn primary" id="btn-equalize" style="font-size:8px;width:100%;padding:5px 0;">⇅ Égaliser les colonnes</button>
      <div style="font-size:7.5px;color:var(--muted);line-height:1.4;">Ajuste auto les espaces entre stages</div>
    </div>
  </div>
  <div class="sp-section">
    <div class="sp-title-row">➕ Ajouter</div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;padding:2px 0;">
      <button class="eb-btn secondary" id="btn-add-spacer" style="font-size:8px;">Esp. G</button>
      <button class="eb-btn secondary" id="btn-add-spacer-r" style="font-size:8px;">Esp. D</button>
    </div>
  </div>
</div>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
'use strict';

// ═══════════════════════════════════════════════════════
// BAKED-IN SETTINGS (from your saved layout)
// ═══════════════════════════════════════════════════════
var SAVED = {
  stageGap: 5,
  ecgOpacity: 0.70,
  nameLeft: -3, nameTop: -17, nameFontSize: 50,
  titreSize: 16,
  photoLeft: -29.8, photoTop: -19.87, photoZoom: 1.4,
  photoRadius: '14px', photoSize: 149
};

// ═══════════════════════════════════════════════════════
// PHOTO
// ═══════════════════════════════════════════════════════
var photoWrap     = document.querySelector('.photo-wrap');
var photoImg      = document.getElementById('cv-photo');
var photoDragZone = document.getElementById('photo-drag-zone');
var photoPanel    = document.getElementById('photo-panel');

var photoLeft = SAVED.photoLeft;
var photoTop  = SAVED.photoTop;
var photoZoom = SAVED.photoZoom;
var dragging  = false, dragX0, dragY0, left0, top0;

function applyPhoto() {
  if (!photoImg || !photoImg.src || photoImg.src === window.location.href) return;
  var wrapPx = photoWrap ? (photoWrap.offsetWidth || SAVED.photoSize) : SAVED.photoSize;
  var sz = Math.round(wrapPx * photoZoom);
  photoImg.style.display  = 'block';
  photoImg.style.width    = sz + 'px';
  photoImg.style.height   = sz + 'px';
  photoImg.style.position = 'absolute';
  photoImg.style.top      = photoTop + 'px';
  photoImg.style.left     = photoLeft + 'px';
}

if (photoDragZone) {
  photoDragZone.addEventListener('mousedown', function(e) {
    e.preventDefault();
    dragging = true; dragX0 = e.clientX; dragY0 = e.clientY;
    left0 = photoLeft; top0 = photoTop;
    photoDragZone.style.cursor = 'grabbing';
  });
}
document.addEventListener('mousemove', function(e) {
  if (!dragging) return;
  photoLeft = left0 + (e.clientX - dragX0);
  photoTop  = top0  + (e.clientY - dragY0);
  applyPhoto();
});
document.addEventListener('mouseup', function() {
  if (!dragging) return;
  dragging = false;
  if (photoDragZone) photoDragZone.style.cursor = 'grab';
});

if (photoWrap && photoPanel) {
  photoWrap.addEventListener('click', function(e) {
    if (dragging) return;
    photoPanel.classList.toggle('visible');
  });
}

var ppZoom = document.getElementById('pp-zoom');
if (ppZoom) {
  ppZoom.value = Math.round(SAVED.photoZoom * 100);
  ppZoom.addEventListener('input', function() {
    var oldZoom = photoZoom;
    photoZoom = parseFloat(this.value) / 100;
    var wrapPx = photoWrap ? (photoWrap.offsetWidth || SAVED.photoSize) : SAVED.photoSize;
    var delta = (photoZoom - oldZoom) * wrapPx;
    photoLeft -= delta / 2; photoTop -= delta / 2;
    applyPhoto();
  });
}

var ppClose = document.getElementById('pp-close');
if (ppClose) ppClose.addEventListener('click', function(e) {
  e.stopPropagation();
  if (photoPanel) photoPanel.classList.remove('visible');
});

var fileInput = document.getElementById('photo-file-input');
if (fileInput) {
  fileInput.addEventListener('change', function() {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
      if (!photoImg) return;
      photoImg.src = e.target.result;
      photoImg.onload = function() {
        var wrapPx = photoWrap ? (photoWrap.offsetWidth || SAVED.photoSize) : SAVED.photoSize;
        var sz = wrapPx * photoZoom;
        photoLeft = -(sz - wrapPx) / 2;
        photoTop  = -(sz - wrapPx) / 3;
        applyPhoto();
      };
    };
    reader.readAsDataURL(file);
  });
}

// ═══════════════════════════════════════════════════════
// FONT SIZE + NAME POSITION
// ═══════════════════════════════════════════════════════
function initFontSlider(sliderId, valId, selector, savedVal) {
  var sl = document.getElementById(sliderId);
  var vl = document.getElementById(valId);
  var el = document.querySelector(selector);
  if (!sl || !el) return;
  sl.value = savedVal;
  if (vl) vl.textContent = savedVal;
  el.style.fontSize = savedVal + 'px';
  sl.addEventListener('input', function() {
    el.style.fontSize = this.value + 'px';
    if (vl) vl.textContent = this.value;
  });
}
initFontSlider('font-name', 'font-name-val', '.header-name', SAVED.nameFontSize);
initFontSlider('font-titre', 'font-titre-val', '.titre-metier', SAVED.titreSize);

var nameXSlider = document.getElementById('name-x');
var nameYSlider = document.getElementById('name-y');
function applyNamePos() {
  var el = document.querySelector('.header-name');
  if (!el) return;
  el.style.left = (nameXSlider ? nameXSlider.value : SAVED.nameLeft) + 'px';
  el.style.top  = (nameYSlider ? nameYSlider.value : SAVED.nameTop) + 'px';
}
if (nameXSlider) { nameXSlider.value = SAVED.nameLeft; nameXSlider.addEventListener('input', applyNamePos); }
if (nameYSlider) { nameYSlider.value = SAVED.nameTop;  nameYSlider.addEventListener('input', applyNamePos); }
applyNamePos();

// ═══════════════════════════════════════════════════════
// ECG OPACITY
// ═══════════════════════════════════════════════════════
var ecgOpacitySlider = document.getElementById('ecg-opacity');
var ecgOpacityVal    = document.getElementById('ecg-opacity-val');
function applyEcgOpacity(pct) {
  document.querySelectorAll('.sh-line polyline').forEach(function(l) { l.style.opacity = pct / 100; });
  if (ecgOpacityVal) ecgOpacityVal.textContent = pct + '%';
}
if (ecgOpacitySlider) {
  ecgOpacitySlider.value = Math.round(SAVED.ecgOpacity * 100);
  ecgOpacitySlider.addEventListener('input', function() { applyEcgOpacity(parseInt(this.value)); });
}
applyEcgOpacity(Math.round(SAVED.ecgOpacity * 100));

// ═══════════════════════════════════════════════════════
// STAGE GAP + EQUALIZE
// ═══════════════════════════════════════════════════════
var stageGapSlider = document.getElementById('sp-stage-gap');
var stageGapVal    = document.getElementById('sp-stage-gap-val');
var currentStageGap = SAVED.stageGap;

function applyStageGap(px) {
  currentStageGap = px;
  var stripe = Math.floor(px / 2);
  document.querySelectorAll('#col-left .stage-card').forEach(function(card) {
    card.style.marginBottom = px + 'px';
    card.style.borderTop    = stripe > 0 ? stripe + 'px solid #eef5fb' : '';
    card.style.borderBottom = stripe > 0 ? stripe + 'px solid #eef5fb' : '';
  });
  if (stageGapVal) stageGapVal.textContent = px + 'px';
  if (stageGapSlider) stageGapSlider.value = px;
}
if (stageGapSlider) {
  stageGapSlider.value = SAVED.stageGap;
  stageGapSlider.addEventListener('input', function() { applyStageGap(parseInt(this.value)); });
}

var btnEqualize = document.getElementById('btn-equalize');
if (btnEqualize) {
  btnEqualize.addEventListener('click', function() {
    var colLeft = document.getElementById('col-left');
    var colRight = document.getElementById('col-right');
    if (!colLeft || !colRight) return;
    var diff = colRight.scrollHeight - colLeft.scrollHeight;
    var cards = colLeft.querySelectorAll('.stage-card');
    if (!cards.length) return;
    var newMb = Math.max(0, Math.round(currentStageGap + diff / cards.length));
    applyStageGap(newMb);
    var dbg = document.getElementById('photo-debug');
    if (dbg) dbg.textContent = 'G=' + colLeft.scrollHeight + 'px D=' + colRight.scrollHeight + 'px | gap=' + newMb + 'px';
  });
}

// ═══════════════════════════════════════════════════════
// PHOTO SHAPE + SIZE
// ═══════════════════════════════════════════════════════
function applyPhotoShape(shape) {
  var map = { round: '50%', square: '0%', rounded: '14px' };
  document.documentElement.style.setProperty('--photo-radius', map[shape] || '14px');
  ['round','square','rounded'].forEach(function(s) {
    var btn = document.getElementById('btn-shape-' + s);
    if (btn) btn.classList.toggle('active', s === shape);
  });
}
['round','square','rounded'].forEach(function(s) {
  var btn = document.getElementById('btn-shape-' + s);
  if (btn) btn.addEventListener('click', function() { applyPhotoShape(s); });
});

var spPhotoSize = document.getElementById('sp-photo-size');
if (spPhotoSize) {
  spPhotoSize.value = SAVED.photoSize;
  spPhotoSize.addEventListener('input', function() {
    var v = parseInt(this.value);
    var valEl = document.getElementById('sp-photo-size-val');
    if (valEl) valEl.textContent = v;
    document.documentElement.style.setProperty('--photo-size', v + 'px');
    var sz = v * photoZoom;
    photoLeft = -(sz - v) / 2;
    photoTop  = -(sz - v) / 3;
    applyPhoto();
  });
}

// Wrap drag (right-click)
var wrapDragging = false, wrapX0, wrapY0, wrapLeft0 = 0, wrapTop0 = 0, wrapOffsetX = 0, wrapOffsetY = 0;
if (photoWrap) {
  photoWrap.addEventListener('contextmenu', function(e) {
    e.preventDefault();
    wrapDragging = true; wrapX0 = e.clientX; wrapY0 = e.clientY;
    wrapLeft0 = wrapOffsetX; wrapTop0 = wrapOffsetY;
    photoWrap.style.cursor = 'move';
  });
}
document.addEventListener('mousemove', function(e) {
  if (!wrapDragging) return;
  wrapOffsetX = wrapLeft0 + (e.clientX - wrapX0);
  wrapOffsetY = wrapTop0  + (e.clientY - wrapY0);
  if (photoWrap) { photoWrap.style.marginLeft = wrapOffsetX + 'px'; photoWrap.style.marginTop = wrapOffsetY + 'px'; }
});
document.addEventListener('mouseup', function() {
  if (wrapDragging) { wrapDragging = false; if (photoWrap) photoWrap.style.cursor = ''; }
});

// ═══════════════════════════════════════════════════════
// EDIT MODE + SIDE PANEL
// ═══════════════════════════════════════════════════════
var toggle      = document.getElementById('edit-toggle');
var page        = document.getElementById('page');
var editActions = document.getElementById('edit-actions');
var sidePanel   = document.getElementById('edit-side-panel');
var editActive  = false;
var selectedEl  = null;

if (toggle) {
  toggle.addEventListener('change', function() {
    editActive = this.checked;
    if (editActions) editActions.style.display = editActive ? 'flex' : 'none';
    if (page) page.classList.toggle('edit-mode', editActive);
    if (sidePanel) {
      sidePanel.classList.toggle('visible', editActive);
      if (editActive) {
        buildSidePanel();
        document.querySelectorAll('[data-block]').forEach(function(el) {
          if (canDrag(el)) makeDraggable(el);
        });
      }
    }
  });
}

function canDrag(el) {
  return !el.classList.contains('header') &&
         !el.classList.contains('accroche') &&
         !el.classList.contains('titre-metier') &&
         !el.classList.contains('wave-separator') &&
         !el.classList.contains('bottom-band') &&
         !el.classList.contains('bottom-col');
}

function buildSidePanel() {
  var list = document.getElementById('sp-block-list');
  if (!list) return;
  list.innerHTML = '';
  document.querySelectorAll('[data-block]').forEach(function(el) {
    var label = el.dataset.label || el.dataset.block || '?';
    var row = document.createElement('div');
    row.className = 'sp-block-row';
    if (canDrag(el)) {
      var drag = document.createElement('span');
      drag.className = 'sp-drag-btn'; drag.textContent = '\u283f';
      row.appendChild(drag);
    } else {
      var pad = document.createElement('span');
      pad.style.cssText = 'width:16px;display:inline-block;';
      row.appendChild(pad);
    }
    var name = document.createElement('span');
    name.className = 'sp-block-name'; name.textContent = label;
    row.appendChild(name);
    var vis = document.createElement('button');
    vis.className = 'sp-vis-btn';
    vis.textContent = el.dataset.hidden === 'true' ? '\uD83D\uDC41' : '\u2715';
    vis.addEventListener('click', function(e) {
      e.stopPropagation();
      el.dataset.hidden = el.dataset.hidden === 'true' ? 'false' : 'true';
      vis.textContent = el.dataset.hidden === 'true' ? '\uD83D\uDC41' : '\u2715';
    });
    row.appendChild(vis);
    row.addEventListener('click', function() {
      document.querySelectorAll('[data-block]').forEach(function(b) { b.classList.remove('sp-hover'); });
      document.querySelectorAll('.sp-block-row').forEach(function(r) { r.classList.remove('active'); });
      el.classList.add('sp-hover'); row.classList.add('active');
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      selectedEl = el; showSpacerControl(el);
    });
    list.appendChild(row);
  });
}

function showSpacerControl(el) {
  var ui = document.getElementById('sp-spacer-ui');
  if (!ui) return;
  var cur = parseInt(el.style.marginTop) || 0;
  while (ui.firstChild) ui.removeChild(ui.firstChild);
  var lbl = document.createElement('div');
  lbl.style.cssText = 'font-size:8px;color:var(--soft);margin-bottom:4px;';
  lbl.textContent = el.dataset.label || el.dataset.block || '';
  ui.appendChild(lbl);
  var rowEl = document.createElement('div'); rowEl.className = 'sp-spacer-row';
  var sp = document.createElement('span'); sp.style.cssText = 'font-size:8px;color:var(--muted);'; sp.textContent = '\u2191 avant'; rowEl.appendChild(sp);
  var rangeEl = document.createElement('input');
  rangeEl.type = 'range'; rangeEl.className = 'sp-spacer-range';
  rangeEl.min = -20; rangeEl.max = 40; rangeEl.value = cur; rangeEl.id = 'sp-range-cur';
  rowEl.appendChild(rangeEl);
  var valEl = document.createElement('span'); valEl.className = 'sp-spacer-val'; valEl.id = 'sp-val-cur'; valEl.textContent = cur + 'px'; rowEl.appendChild(valEl);
  ui.appendChild(rowEl);
  var presetsEl = document.createElement('div'); presetsEl.style.cssText = 'display:flex;gap:4px;margin-top:4px;';
  [-12,-6,0,6,12].forEach(function(v) {
    var btn = document.createElement('button');
    btn.textContent = v;
    btn.style.cssText = 'font-size:8px;padding:2px 5px;background:rgba(255,255,255,0.12);border:none;border-radius:3px;color:rgba(255,255,255,0.75);cursor:pointer;';
    btn.addEventListener('click', function() { setSpacing(v); });
    presetsEl.appendChild(btn);
  });
  ui.appendChild(presetsEl);
  rangeEl.addEventListener('input', function() {
    el.style.marginTop = this.value + 'px';
    valEl.textContent = this.value + 'px';
  });
}

function setSpacing(v) {
  if (!selectedEl) return;
  selectedEl.style.marginTop = v + 'px';
  var r = document.getElementById('sp-range-cur');
  var vl = document.getElementById('sp-val-cur');
  if (r) r.value = v;
  if (vl) vl.textContent = v + 'px';
}

// ═══════════════════════════════════════════════════════
// DRAG & DROP BLOCS
// ═══════════════════════════════════════════════════════
var dragSrc = null;
function makeDraggable(el) {
  el.addEventListener('mousedown', function() { el.setAttribute('draggable', 'true'); });
  el.addEventListener('dragstart', function(e) { dragSrc = el; el.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move'; });
  el.addEventListener('dragend', function() { el.classList.remove('dragging'); el.setAttribute('draggable','false'); document.querySelectorAll('[data-block]').forEach(function(b){b.classList.remove('drag-over');}); dragSrc=null; buildSidePanel(); });
  el.addEventListener('dragover', function(e) { e.preventDefault(); if(dragSrc&&dragSrc!==el&&el.parentNode===dragSrc.parentNode) el.classList.add('drag-over'); });
  el.addEventListener('dragleave', function() { el.classList.remove('drag-over'); });
  el.addEventListener('drop', function(e) {
    e.preventDefault(); el.classList.remove('drag-over');
    if(dragSrc&&dragSrc!==el&&el.parentNode===dragSrc.parentNode){
      var parent=el.parentNode, si=Array.from(parent.children).indexOf(dragSrc), ti=Array.from(parent.children).indexOf(el);
      if(si<ti) parent.insertBefore(dragSrc,el.nextSibling); else parent.insertBefore(dragSrc,el);
    }
  });
}

// ═══════════════════════════════════════════════════════
// SPACERS
// ═══════════════════════════════════════════════════════
function createSpacer(h) {
  var el = document.createElement('div');
  el.dataset.block = 'spacer'; el.dataset.label = 'Espaceur';
  el.style.height = (h||16)+'px'; el.style.position='relative';
  if (editActive) makeDraggable(el);
  return el;
}
var btnSL = document.getElementById('btn-add-spacer');
var btnSR = document.getElementById('btn-add-spacer-r');
if (btnSL) btnSL.addEventListener('click', function() { var c=document.getElementById('col-left'); if(c){c.appendChild(createSpacer(16));buildSidePanel();} });
if (btnSR) btnSR.addEventListener('click', function() { var c=document.getElementById('col-right'); if(c){c.appendChild(createSpacer(16));buildSidePanel();} });

// ═══════════════════════════════════════════════════════
// EXPORT / IMPORT JSON
// ═══════════════════════════════════════════════════════
function captureState() {
  var blocks = [];
  document.querySelectorAll('[data-block]').forEach(function(el) {
    blocks.push({ block:el.dataset.block, label:el.dataset.label||'', hidden:el.dataset.hidden==='true', marginTop:el.style.marginTop||'0px' });
  });
  return { version:'cv_v17', timestamp:new Date().toISOString(), blocks:blocks,
    settings:{ stageGap:currentStageGap, ecgOpacity:ecgOpacitySlider?ecgOpacitySlider.value/100:SAVED.ecgOpacity,
      nameLeft:nameXSlider?nameXSlider.value:SAVED.nameLeft, nameTop:nameYSlider?nameYSlider.value:SAVED.nameTop,
      nameFontSize:document.querySelector('.header-name')?parseInt(document.querySelector('.header-name').style.fontSize)||SAVED.nameFontSize:SAVED.nameFontSize,
      photoLeft:photoLeft, photoTop:photoTop, photoZoom:photoZoom }};
}
var btnJson = document.getElementById('btn-export-json');
if (btnJson) btnJson.addEventListener('click', function() {
  var blob = new Blob([JSON.stringify(captureState(),null,2)],{type:'application/json'});
  var a = document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='cv_beyer_layout.json'; a.click();
});
var btnHtml = document.getElementById('btn-export-html');
if (btnHtml) btnHtml.addEventListener('click', function() {
  // Export le document complet tel quel — toutes les modifs inline sont préservées
  // On retire juste la classe edit-mode si active, et les toolbars visuels
  var wasEdit = document.getElementById('page').classList.contains('edit-mode');
  if (wasEdit) document.getElementById('page').classList.remove('edit-mode');
  document.querySelectorAll('.block-toolbar').forEach(function(t){ t.style.display='none'; });
  // Clean up JS-only tracking attributes so exported file re-binds correctly
  document.querySelectorAll('[data-modal-bound]').forEach(function(el){ el.removeAttribute('data-modal-bound'); });
  document.querySelectorAll('[data-xp-bound]').forEach(function(el){ el.removeAttribute('data-xp-bound'); });
  document.querySelectorAll('[data-info-bound]').forEach(function(el){ el.removeAttribute('data-info-bound'); });

  // Embed photo base64 if loaded locally
  var origImg = document.getElementById('cv-photo');
  var origSrc = origImg ? origImg.src : '';

  // Capture full document HTML
  var html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;

  // Restore edit state
  if (wasEdit) document.getElementById('page').classList.add('edit-mode');
  document.querySelectorAll('.block-toolbar').forEach(function(t){ t.style.display=''; });

  var blob = new Blob([html], {type:'text/html'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'cv_beyer_2026_export.html';
  a.click();
});
var importInput = document.getElementById('import-json-input');
if (importInput) importInput.addEventListener('change', function() {
  var file=this.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(e){
    try {
      var data=JSON.parse(e.target.result);
      if(data.blocks) data.blocks.forEach(function(s){
        var el=document.querySelector('[data-block="'+s.block+'"]');
        if(!el) return;
        if(s.hidden) el.dataset.hidden='true';
        if(s.marginTop&&s.marginTop!=='0px') el.style.marginTop=s.marginTop;
      });
      if(data.settings) {
        var s=data.settings;
        if(s.stageGap!==undefined) applyStageGap(s.stageGap);
        if(s.ecgOpacity!==undefined) { applyEcgOpacity(Math.round(s.ecgOpacity*100)); if(ecgOpacitySlider) ecgOpacitySlider.value=Math.round(s.ecgOpacity*100); }
        if(s.nameFontSize) { var ne=document.querySelector('.header-name'); if(ne) ne.style.fontSize=s.nameFontSize+'px'; if(document.getElementById('font-name')) document.getElementById('font-name').value=s.nameFontSize; }
        if(s.nameLeft!==undefined&&nameXSlider){nameXSlider.value=s.nameLeft;}
        if(s.nameTop!==undefined&&nameYSlider){nameYSlider.value=s.nameTop;}
        applyNamePos();
        if(s.photoLeft!==undefined){photoLeft=parseFloat(s.photoLeft);}
        if(s.photoTop!==undefined){photoTop=parseFloat(s.photoTop);}
        if(s.photoZoom!==undefined){photoZoom=parseFloat(s.photoZoom); if(ppZoom) ppZoom.value=Math.round(s.photoZoom*100);}
        applyPhoto();
      }
      if(typeof buildSidePanel==='function') buildSidePanel();
    } catch(err){alert('Erreur JSON: '+err.message);}
  };
  reader.readAsText(file); this.value='';
});

// ═══════════════════════════════════════════════════════
// AJOUTER UN STAGE
// ═══════════════════════════════════════════════════════
var btnAddStage = document.getElementById('btn-add-stage');
var stageForm   = document.getElementById('stage-form');
var sfOk        = document.getElementById('sf-ok');
var sfCancel    = document.getElementById('sf-cancel');

if (btnAddStage) btnAddStage.addEventListener('click', function() {
  if (stageForm) stageForm.classList.toggle('visible');
});
if (sfCancel) sfCancel.addEventListener('click', function() {
  if (stageForm) stageForm.classList.remove('visible');
});
if (sfOk) sfOk.addEventListener('click', function() {
  var date  = (document.getElementById('sf-date')||{}).value||'';
  var title = (document.getElementById('sf-title')||{}).value||'';
  var lieu  = (document.getElementById('sf-lieu')||{}).value||'';
  var tagsRaw=(document.getElementById('sf-tags')||{}).value||'';
  var detail=(document.getElementById('sf-detail')||{}).value||'';
  if (!title) { alert('Le titre est requis.'); return; }

  var card = document.createElement('div');
  card.className = 'stage-card';
  card.style.marginBottom = currentStageGap + 'px';
  card.style.borderTop    = Math.floor(currentStageGap/2) > 0 ? Math.floor(currentStageGap/2)+'px solid #eef5fb' : '';
  card.style.borderBottom = card.style.borderTop;

  if (date)  card.innerHTML += '<div class="stage-date">' + date + '</div>';
  card.innerHTML += '<div class="stage-title">' + title + '</div>';
  if (lieu)  card.innerHTML += '<div class="stage-lieu">' + lieu + '</div>';

  if (tagsRaw) {
    var tagsEl = document.createElement('div');
    tagsEl.className = 'stage-tags';
    tagsRaw.split(',').forEach(function(t) {
      t = t.trim();
      if (!t) return;
      var span = document.createElement('span');
      span.className = 'stag'; span.textContent = t;
      tagsEl.appendChild(span);
    });
    card.appendChild(tagsEl);
  }

  if (detail) {
    var detailEl = document.createElement('div');
    detailEl.className = 'stage-detail';
    detailEl.textContent = detail;
    card.appendChild(detailEl);
  }

  // Insert before the add button
  var stagesContainer = document.querySelector('#col-left [data-block="stages"]');
  var addBtn = document.getElementById('btn-add-stage');
  if (stagesContainer && addBtn) stagesContainer.insertBefore(card, addBtn);

  // Clear form
  ['sf-date','sf-title','sf-lieu','sf-tags','sf-detail'].forEach(function(id){
    var el=document.getElementById(id); if(el) el.value='';
  });
  if (stageForm) stageForm.classList.remove('visible');
  applyStageGap(currentStageGap);
});

// ═══════════════════════════════════════════════════════
// STAGE MODAL
// ═══════════════════════════════════════════════════════
var modalOverlay = document.getElementById('stage-modal-overlay');
var smClose      = document.getElementById('sm-close');
var currentCard  = null;
var _boundCards  = new Set(); // tracks cards with click listeners (JS-only, not in HTML)

function openStageModal(card) {
  currentCard = card;
  // Fill header
  var dateEl  = card.querySelector('.stage-date');
  var titleEl = card.querySelector('.stage-title');
  var lieuEl  = card.querySelector('.stage-lieu');
  document.getElementById('sm-date').textContent  = dateEl  ? dateEl.textContent  : '';
  document.getElementById('sm-title').textContent = titleEl ? titleEl.textContent : '';
  document.getElementById('sm-lieu').textContent  = lieuEl  ? lieuEl.textContent  : '';

  // Tag manager — all tags from data-tags-all, toggleable
  var tagsContainer = document.getElementById('sm-tags');
  var tagsTitle = document.getElementById('sm-tags-title');
  tagsContainer.innerHTML = '';

  var allTagsRaw = card.dataset.tagsAll || '';
  var allTags = [];
  try { if (allTagsRaw) allTags = JSON.parse(allTagsRaw.replace(/&#39;/g,"'")); } catch(e) {}

  // If no data-tags-all, fallback to current visible .stag spans
  if (!allTags.length) {
    card.querySelectorAll('.stag').forEach(function(t) { allTags.push(t.textContent); });
  }

  // Get currently hidden tags from card data
  var hiddenTagsRaw = card.dataset.hiddenTags || '';
  var hiddenTags = hiddenTagsRaw ? hiddenTagsRaw.split('||') : [];

  if (allTags.length) {
    if (tagsTitle) tagsTitle.style.display = '';
    allTags.forEach(function(tagText) {
      var pill = document.createElement('span');
      pill.className = 'sm-tag-pill';
      pill.textContent = tagText;
      var isHidden = hiddenTags.indexOf(tagText) > -1;
      if (isHidden) pill.classList.add('hidden-tag');

      pill.addEventListener('click', function() {
        var idx = hiddenTags.indexOf(tagText);
        if (idx > -1) {
          // Unhide
          hiddenTags.splice(idx, 1);
          pill.classList.remove('hidden-tag');
        } else {
          // Hide
          hiddenTags.push(tagText);
          pill.classList.add('hidden-tag');
        }
        // Save back to card
        card.dataset.hiddenTags = hiddenTags.join('||');
        // Update visible tags on card
        syncCardTags(card, allTags, hiddenTags);
      });
      tagsContainer.appendChild(pill);
    });
  } else {
    if (tagsTitle) tagsTitle.style.display = 'none';
  }

  // Detail text (data-detail attr or .stage-detail element)
  var detailText = card.dataset.detail || '';
  var detailEl = card.querySelector('.stage-detail');
  if (!detailText && detailEl) detailText = detailEl.textContent;
  var smDetailSec = document.getElementById('sm-detail-section');
  var smDetail    = document.getElementById('sm-detail');
  if (detailText) {
    smDetailSec.style.display = 'block';
    smDetail.innerHTML = renderDetailHtml(detailText);
  } else {
    smDetailSec.style.display = 'none';
    smDetail.textContent = '';
  }

  // AP section
  var apUrl  = card.dataset.apUrl  || '';
  var apText = card.dataset.apText || '';
  // Also check .stage-ap element
  var apEl = card.querySelector('.stage-ap');
  if (!apText && apEl) apText = apEl.textContent;
  var smApSec  = document.getElementById('sm-ap-section');
  var smApText = document.getElementById('sm-ap-text');
  var smApLink = document.getElementById('sm-ap-link');
  if (apText || apUrl) {
    smApSec.style.display = 'block';
    smApText.textContent = apText;
    if (apUrl) {
      smApLink.href = apUrl;
      smApLink.style.display = 'inline-flex';
    } else {
      smApLink.style.display = 'none';
    }
  } else {
    smApSec.style.display = 'none';
  }

  // Edit zone
  var smEditZone = document.getElementById('sm-edit-zone');
  smEditZone.style.display = editActive ? 'block' : 'none';
  if (editActive) {
    // Tags : charger depuis data-tags-all ou les .stag visibles
    var tagsInput = document.getElementById('sm-edit-tags');
    if (tagsInput) {
      var allTagsRaw2 = card.dataset.tagsAll || '';
      var allTags2 = [];
      try { if (allTagsRaw2) allTags2 = JSON.parse(allTagsRaw2.replace(/&#39;/g,"'")); } catch(e) {}
      if (!allTags2.length) {
        card.querySelectorAll('.stag').forEach(function(t) { allTags2.push(t.textContent); });
      }
      tagsInput.value = allTags2.join(', ');
    }
    document.getElementById('sm-edit-detail').value  = card.dataset.detail  || (detailEl ? detailEl.textContent : '');
    document.getElementById('sm-edit-ap-url').value  = card.dataset.apUrl   || '';
    document.getElementById('sm-edit-ap-text').value = card.dataset.apText  || (apEl ? apEl.textContent : '');
  }

  // ── Bilan de stage ──────────────────────────────────────
  var bilanUrl = card.dataset.bilanUrl || '';
  var bilanSec  = document.getElementById('sm-bilan-section');
  var bilanLink = document.getElementById('sm-bilan-link');
  if (bilanUrl && bilanSec && bilanLink) {
    bilanLink.href = bilanUrl;
    bilanSec.style.display = 'block';
  } else if (bilanSec) {
    bilanSec.style.display = 'none';
  }

  // ── AP link ─────────────────────────────────────────────
  var apUrl2 = card.dataset.apUrl || '';
  if (apUrl2 && smApLink) {
    smApLink.href = apUrl2;
    smApLink.style.display = 'inline-flex';
  }

  // ── Edit zone bilan field ───────────────────────────────
  var bilanInput = document.getElementById('sm-edit-bilan-url');
  if (bilanInput) bilanInput.value = bilanUrl;

  if (modalOverlay) modalOverlay.classList.add('open');
}

function closeStageModal() {
  if (modalOverlay) modalOverlay.classList.remove('open');
  currentCard = null;
}

if (smClose) smClose.addEventListener('click', closeStageModal);
if (modalOverlay) {
  modalOverlay.addEventListener('click', function(e) {
    if (e.target === modalOverlay) closeStageModal();
  });
}

// Save edits back to card
var smEditSave = document.getElementById('sm-edit-save');
if (smEditSave) smEditSave.addEventListener('click', function() {
  if (!currentCard) return;
  var detail  = document.getElementById('sm-edit-detail').value;
  var apUrl   = document.getElementById('sm-edit-ap-url').value;
  var apText  = document.getElementById('sm-edit-ap-text').value;
  var bilanIn = document.getElementById('sm-edit-bilan-url');
  var tagsIn  = document.getElementById('sm-edit-tags');
  currentCard.dataset.detail = detail;
  currentCard.dataset.apUrl  = apUrl;
  currentCard.dataset.apText = apText;
  if (bilanIn) currentCard.dataset.bilanUrl = bilanIn.value;
  // Reconstruire les tags
  if (tagsIn) {
    var newTags = tagsIn.value.split(',').map(function(t){return t.trim();}).filter(function(t){return t.length > 0;});
    currentCard.dataset.tagsAll    = JSON.stringify(newTags);
    currentCard.dataset.hiddenTags = '';
    var tagsEl = currentCard.querySelector('.stage-tags');
    if (!tagsEl) {
      tagsEl = document.createElement('div');
      tagsEl.className = 'stage-tags';
      var lieuEl2 = currentCard.querySelector('.stage-lieu');
      if (lieuEl2) lieuEl2.parentNode.insertBefore(tagsEl, lieuEl2.nextSibling);
      else currentCard.appendChild(tagsEl);
    }
    tagsEl.innerHTML = '';
    newTags.forEach(function(tag) {
      var sp = document.createElement('span');
      sp.className = 'stag';
      sp.textContent = tag;
      tagsEl.appendChild(sp);
    });
  }
  // Update visible .stage-ap if exists
  var apEl = currentCard.querySelector('.stage-ap');
  if (apText) {
    if (!apEl) {
      apEl = document.createElement('div');
      apEl.className = 'stage-ap';
      currentCard.appendChild(apEl);
    }
    apEl.textContent = apText;
  } else if (apEl) {
    apEl.remove();
  }
  closeStageModal();
});

// Keyboard close
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeStageModal();
});

// Attach click listeners to all stage cards
function syncCardTags(card, allTags, hiddenTags) {
  var tagsEl = card.querySelector('.stage-tags');
  if (!tagsEl) return;
  tagsEl.innerHTML = '';
  allTags.forEach(function(tagText) {
    if (hiddenTags.indexOf(tagText) > -1) return; // skip hidden
    var span = document.createElement('span');
    span.className = 'stag';
    span.textContent = tagText;
    tagsEl.appendChild(span);
  });
}

function attachCardClicks() {
  document.querySelectorAll('.stage-card').forEach(function(card) {
    // Always re-attach (data-modal-bound may exist from export)
    // Remove old listeners by cloning the card's click area... 
    // Simpler: use a JS-side Set to track bound cards
    if (_boundCards.has(card)) return;
    _boundCards.add(card);

    // Add edit pencil button
    if (!card.querySelector('.stage-edit-btn')) {
      var pencil = document.createElement('button');
      pencil.className = 'stage-edit-btn';
      pencil.textContent = '✎';
      pencil.title = 'Modifier ce stage';
      pencil.addEventListener('click', function(e) {
        e.stopPropagation();
        openStageModal(card);
      });
      card.appendChild(pencil);
    }

    card.addEventListener('click', function(e) {
      if (e.target.classList.contains('stage-edit-btn')) return;
      // Don't open modal if clicking add-stage-btn area
      if (e.target.closest('.add-stage-btn') || e.target.closest('.stage-form')) return;
      openStageModal(card);
    });
  });
}
attachCardClicks();

// Also attach after new stage is added
var origSfOk = document.getElementById('sf-ok');
if (origSfOk) {
  origSfOk.addEventListener('click', function() {
    setTimeout(attachCardClicks, 100);
  });
}

// ═══════════════════════════════════════════════════════
// EXPÉRIENCE PRO MODAL
// ═══════════════════════════════════════════════════════
var xpOverlay   = document.getElementById('xp-modal-overlay');
var xmClose     = document.getElementById('xm-close');
var currentTlItem = null;

function openXpModal(item) {
  currentTlItem = item;
  document.getElementById('xm-date').textContent  = item.dataset.xpDate  || '';
  document.getElementById('xm-title').textContent = item.dataset.xpTitle || '';
  document.getElementById('xm-lieu').textContent  = item.dataset.xpLieu  || '';
  document.getElementById('xm-detail').innerHTML = renderDetailHtml(item.dataset.xpDetail || '');

  // Tags
  var tagsEl = document.getElementById('xm-tags');
  tagsEl.innerHTML = '';
  var tagsRaw = item.dataset.xpTags || '';
  if (tagsRaw) {
    tagsRaw.split(',').forEach(function(t) {
      t = t.trim(); if (!t) return;
      var span = document.createElement('span');
      span.className = 'sm-tag'; span.textContent = t;
      tagsEl.appendChild(span);
    });
  }

  // Bilan / document link
  var bilanUrl = item.dataset.xpBilanUrl || '';
  var xmBilanSec   = document.getElementById('xm-bilan-section');
  var xmBilanLink  = document.getElementById('xm-bilan-link');
  var xmBilanLabel = document.getElementById('xm-bilan-label');
  if (bilanUrl && bilanUrl !== 'LIEN_RELEVE_NOTES_A_COMPLETER' && xmBilanSec && xmBilanLink) {
    xmBilanLink.href = bilanUrl;
    xmBilanSec.style.display = 'block';
    // Set label based on content
    if (xmBilanLabel) {
      var title = item.dataset.xpTitle || '';
      if (title.indexOf('MERM') > -1 || title.indexOf('Diplôme') > -1) {
        xmBilanLabel.textContent = 'Consulter le relevé de notes officiel';
      } else if (title.indexOf('préparatoire') > -1 || title.indexOf('Orcea') > -1) {
        xmBilanLabel.textContent = 'Consulter le bulletin de notes officiel';
      } else {
        xmBilanLabel.textContent = 'Consulter le document officiel';
      }
    }
  } else if (xmBilanSec) {
    xmBilanSec.style.display = 'none';
  }

  // Edit zone
  var ez = document.getElementById('xm-edit-zone');
  ez.style.display = editActive ? 'block' : 'none';
  if (editActive) {
    document.getElementById('xm-edit-detail').value = item.dataset.xpDetail || '';
    document.getElementById('xm-edit-tags').value   = item.dataset.xpTags   || '';
    var bilanInput = document.getElementById('xm-edit-bilan-url');
    if (bilanInput) bilanInput.value = bilanUrl;
  }

  if (xpOverlay) { xpOverlay.style.display = 'flex'; xpOverlay.style.alignItems = 'center'; xpOverlay.style.justifyContent = 'center'; }
}

function closeXpModal() {
  if (xpOverlay) xpOverlay.style.display = 'none';
  currentTlItem = null;
}

if (xmClose) xmClose.addEventListener('click', closeXpModal);
if (xpOverlay) xpOverlay.addEventListener('click', function(e) { if (e.target === xpOverlay) closeXpModal(); });

var xmSave = document.getElementById('xm-edit-save');
if (xmSave) xmSave.addEventListener('click', function() {
  if (!currentTlItem) return;
  currentTlItem.dataset.xpDetail = document.getElementById('xm-edit-detail').value;
  currentTlItem.dataset.xpTags   = document.getElementById('xm-edit-tags').value;
  var bu = document.getElementById('xm-edit-bilan-url');
  if (bu) currentTlItem.dataset.xpBilanUrl = bu.value;
  closeXpModal();
});

// Attach click to all tl-items with data-xp-detail
var _boundXpItems = new Set();
function attachXpClicks() {
  document.querySelectorAll('.tl-item[data-xp-detail]').forEach(function(item) {
    if (_boundXpItems.has(item)) return;
    _boundXpItems.add(item);
    item.addEventListener('click', function() { openXpModal(item); });
  });
}
attachXpClicks();

// Also close with Escape
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') { closeXpModal(); closeInfoModal(); }
});

// ═══════════════════════════════════════════════════════
// INFO MODAL (savoir-être + intérêts)
// ═══════════════════════════════════════════════════════
var infoOverlay = document.getElementById('info-modal-overlay');
var imClose     = document.getElementById('im-close');

function renderDetailHtml(text) {
  // Convert structured plain text to clean HTML
  var lines = text.split('\n');
  var html = '';
  var inList = false;
  lines.forEach(function(line) {
    line = line.trimRight();
    if (!line) {
      if (inList) { html += '</ul>'; inList = false; }
      return; // skip blank
    }
    // Bullet point
    if (line.match(/^[•·\-]\s+/)) {
      if (!inList) { html += '<ul class="im-list">'; inList = true; }
      var txt = line.replace(/^[•·\-]\s+/, '');
      html += '<li>' + txt + '</li>';
    }
    // Section header (ends with :)
    else if (line.match(/^[A-ZÀ-Ÿ📊📋🏥📚💡][^:]*:$/) || line.match(/^[📊📋🏥📚💡]/)) {
      if (inList) { html += '</ul>'; inList = false; }
      html += '<div class="im-section">' + line + '</div>';
    }
    // Regular paragraph
    else {
      if (inList) { html += '</ul>'; inList = false; }
      html += '<p>' + line + '</p>';
    }
  });
  if (inList) html += '</ul>';
  return html;
}

function openInfoModal(title, detail) {
  document.getElementById('im-title').textContent = title;
  document.getElementById('im-body').innerHTML = renderDetailHtml(detail);
  if (infoOverlay) { infoOverlay.style.display = 'flex'; infoOverlay.style.alignItems = 'center'; infoOverlay.style.justifyContent = 'center'; }
}
function closeInfoModal() {
  if (infoOverlay) infoOverlay.style.display = 'none';
}
if (imClose) imClose.addEventListener('click', closeInfoModal);
if (infoOverlay) infoOverlay.addEventListener('click', function(e) { if (e.target === infoOverlay) closeInfoModal(); });

// Attach to all .info-tag elements
var _boundInfoTags = new Set();
function attachInfoTags() {
  document.querySelectorAll('.info-tag').forEach(function(tag) {
    if (_boundInfoTags.has(tag)) return;
    _boundInfoTags.add(tag);
    tag.addEventListener('click', function(e) {
      e.stopPropagation();
      openInfoModal(tag.dataset.infoTitle || tag.textContent, tag.dataset.infoDetail || '');
    });
  });
}
attachInfoTags();

// ═══════════════════════════════════════════════════════
// BILAN DE STAGE — show/hide in stage modal
// ═══════════════════════════════════════════════════════
// bilan handling moved into openStageModal directly

// ═══════════════════════════════════════════════════════
// PRINT — force clean state
// ═══════════════════════════════════════════════════════
window.addEventListener('beforeprint', function() {
  // Hide edit bar completely
  var eb = document.getElementById('edit-bar');
  if (eb) eb.style.display = 'none';
  // Hide side panel
  if (sidePanel) sidePanel.style.display = 'none';
  // Close any open modals
  var overlays = ['stage-modal-overlay','xp-modal-overlay','info-modal-overlay'];
  overlays.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });
  // Restore page to full width layout
  document.body.style.gap = '0';
  document.body.style.padding = '0';
});
window.addEventListener('afterprint', function() {
  // Restore edit bar
  var eb = document.getElementById('edit-bar');
  if (eb) eb.style.display = '';
  if (editActive && sidePanel) sidePanel.style.display = '';
  document.body.style.gap = '';
  document.body.style.padding = '';
});

// ═══════════════════════════════════════════════════════
// DEBUG
// ═══════════════════════════════════════════════════════
(function() {
  if (photoImg) {
    photoImg.addEventListener('load', function() {
      var dbg = document.getElementById('photo-debug');
      if (dbg) dbg.textContent = 'Photo OK ' + photoImg.naturalWidth + 'x' + photoImg.naturalHeight + 'px';
    });
  }
})();

// ═══════════════════════════════════════════════════════
// INIT — apply all saved settings on load
// ═══════════════════════════════════════════════════════
applyPhoto();
applyEcgOpacity(Math.round(SAVED.ecgOpacity * 100));
applyStageGap(SAVED.stageGap);

// ═══════════════════════════════════════════════════════
// MODE PUBLICATION — masque tout l'édition sauf si ?edit=1
// ═══════════════════════════════════════════════════════
(function() {
  var params = new URLSearchParams(window.location.search);
  if (params.get('edit') !== '1') {
    // Masquer la barre d'édition
    var eb = document.getElementById('edit-bar');
    if (eb) eb.style.display = 'none';
    // Masquer le panneau latéral
    if (sidePanel) sidePanel.style.display = 'none';
    // Désactiver le toggle (au cas où)
    if (toggle) toggle.disabled = true;
    // Supprimer le padding/gap du body liés à la barre
    document.body.style.paddingTop = '0';
    document.body.style.gap = '0';
    // Retirer le padding top du body pour que la page soit centrée proprement
    document.body.style.padding = '0';
    document.body.style.background = '#fff';
  }
})();
</script></body><ebc-ext-slider></ebc-ext-slider><div id="widilo-popup-container" data-content-script-id="562c1d34-31a5-4351-8dae-fef23f635c99"></div><div id="ag9c86vjp0"></div></html>